# PostgreSQL credentials — copy to .env and edit. Never commit the real .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=appdb

# Host publishing. 127.0.0.1 = localhost only; 0.0.0.0 = reachable on the LAN.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432

# Timezone
TZ=UTC

# Naming used by the helper scripts
CONTAINER_NAME=postgres

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# Optional pgAdmin profile (docker compose --profile admin up -d)
PGADMIN_EMAIL=admin@homelab.local
PGADMIN_PASSWORD=change-this-too
PGADMIN_BIND_ADDR=127.0.0.1
PGADMIN_PORT=5050
